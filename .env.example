# Copy to .env locally, or paste each line into Coolify's Environment Variables panel.
# All FREQTRADE__* env vars override values inside the JSON config files.
# DO NOT commit a real .env to git. Mark secrets as "is secret" in Coolify.

# --- bot identity ---
FREQTRADE__BOT_NAME=prod
FREQTRADE__STRATEGY=NostalgiaForInfinityX7

# --- trading mode ---
FREQTRADE__TRADING_MODE=spot
# FREQTRADE__MARGIN_MODE=isolated   # only for futures

# --- risk sizing (start small) ---
# FREQTRADE__MAX_OPEN_TRADES=10
# FREQTRADE__STAKE_AMOUNT=50        # uncomment to cap stake per slot

# --- exchange (SECRETS) ---
FREQTRADE__EXCHANGE__NAME=binance
FREQTRADE__EXCHANGE__KEY=replace_me
FREQTRADE__EXCHANGE__SECRET=replace_me
# FREQTRADE__EXCHANGE__PASSWORD=    # only some exchanges (kucoin/okx)

# --- telegram (SECRETS) ---
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=replace_me
FREQTRADE__TELEGRAM__CHAT_ID=replace_me

# --- web UI / REST API (SECRETS) ---
FREQTRADE__API_SERVER__ENABLED=true
FREQTRADE__API_SERVER__LISTEN_PORT=8080
FREQTRADE__API_SERVER__USERNAME=replace_me
FREQTRADE__API_SERVER__PASSWORD=replace_me
FREQTRADE__API_SERVER__JWT_SECRET_KEY=replace_me_with_openssl_rand_hex_32
FREQTRADE__API_SERVER__WS_TOKEN=replace_me_with_openssl_rand_hex_32

# --- runtime ---
TZ=UTC
FREQTRADE__DRY_RUN=true               # KEEP true until backtest + 2-4w paper-trade pass
