# Minimal production image for live/dry-run trading.
# Skips test/backtest deps (numba, pytest, etc.) that Dockerfile.custom installs.
# Build via docker-compose.yml; Dockerfile.custom remains for backtests.

FROM freqtradeorg/freqtrade:stable

USER root

# Bake configs and strategy into the image so Coolify (which doesn't
# honor relative bind-mounts) has them at runtime without volumes.
COPY --chown=1000:1000 configs /freqtrade/configs
COPY --chown=1000:1000 NostalgiaForInfinityX7.py /freqtrade/NostalgiaForInfinityX7.py

USER ftuser
