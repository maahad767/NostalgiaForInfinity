# Minimal production image for live/dry-run trading.
# Skips test/backtest deps (numba, pytest, etc.) that Dockerfile.custom installs.
# Build via docker-compose.yml; Dockerfile.custom remains for backtests.

FROM freqtradeorg/freqtrade:stable

USER root

# Bake configs and strategy into the image so Coolify (which doesn't
# honor relative bind-mounts) has them at runtime without volumes.
COPY --chown=1000:1000 configs /freqtrade/configs
COPY --chown=1000:1000 NostalgiaForInfinityX7.py /freqtrade/NostalgiaForInfinityX7.py
# Local overlay (see NFIX7Local.py). Selected via FREQTRADE__STRATEGY; the
# container name and --strategy come from that env var, so this file MUST be in
# the image or freqtrade crash-loops on an unresolvable strategy.
COPY --chown=1000:1000 NFIX7Local.py /freqtrade/NFIX7Local.py
# X8 (stock) is the live strategy from 2026-09-24; X7 + NFIX7Local stay in the image so
# a rollback is just FREQTRADE__STRATEGY in .env + a rebuild.
COPY --chown=1000:1000 NostalgiaForInfinityX8.py /freqtrade/NostalgiaForInfinityX8.py

USER ftuser
